om Subscribers sms WT1268282 To12800\nBSNL (South / East) Subscribers sms 4989881 To 56700\nBSNL (North / West) Subscribers sms 2169063 To 56700\nVirgin Subscribers sms TT 4989881 To 58475\nMTS Subscribers Dial 52222628654\nUninor Subscribers Dial 522226140589\nMTNL Subscribers SMS PT 4989881 To 56789","commandRuns":[{"startIndex":356,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAYiEwjd9qqxqPyVAxUlkKwCHb88BiVI3_7D9-68j8JyygEEnH3T9g==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUmZRdWVKRzhzX3RvRms5ZmE5Wmd5NnxBR3JiS2Frd01FM1V1XzRsOEJRS1JHU2FCNmEtazJOa203cVFXb2RsZ0hmUE1pclFfWnBfaE1uSVdxU213NEtfT25FYlR2MDRQd3dxdzN5Z1ZyVHJjR3RDZU9CcFpJcmJXU0g5\u0026q=https%3A%2F%2Fitunes.apple.com%2Fin%2Falbum%2Fmain-tera-hero-original-motion%2Fid843259764\u0026v=coQ95u7w_18","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUmZRdWVKRzhzX3RvRms5ZmE5Wmd5NnxBR3JiS2Frd01FM1V1XzRsOEJRS1JHU2FCNmEtazJOa203cVFXb2RsZ0hmUE1pclFfWnBfaE1uSVdxU213NEtfT25FYlR2MDRQd3dxdzN5Z1ZyVHJjR3RDZU9CcFpJcmJXU0g5\u0026q=https%3A%2F%2Fitunes.apple.com%2Fin%2Falbum%2Fmain-tera-hero-original-motion%2Fid843259764\u0026v=coQ95u7w_18","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":489,"length":14,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAYiEwjd9qqxqPyVAxUlkKwCHb88BiXKAQScfdP2","commandMetadata":{"webCommandMetadata":{"url":"http://www.youtube.com/tseries","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"http://www.youtube.com/tseries","nofollow":true}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: tseries"}}},{"startIndex":528,"length":18,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAYiEwjd9qqxqPyVAxUlkKwCHb88BiVI3_7D9-68j8JyygEEnH3T9g==","commandMetadata":{"webCommandMetadata":{"url":"